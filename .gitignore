# Local credentials — never commit. The npm token lives in .env (see the expiry comment there);
# packages/cli/.npmrc references ${NPM_TOKEN} from the environment for npm publish.
.env
.env.*
!.env.example
.npmrc

# What a Nexo environment generates next to a project (per AI) or keeps for one user — this repository is developed
# inside one, so these must never be committed. The repo's own .claude/CLAUDE.md is the only exception.
.claude/*
!.claude/CLAUDE.md
.mcp.json
opencode.json
.opencode/
.codex/
.gemini/
.engram/
.state/
environment.config.json
