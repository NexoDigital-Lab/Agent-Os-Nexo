{
  "name": "@nexodigital-lab/agent-os",
  "version": "1.0.0",
  "private": true,
  "description": "agent-os: the local app of a Nexo environment, built from modules.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "files": [
    "host",
    "modules",
    "src",
    "schema",
    "docs",
    "scripts",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node host/server/main.ts --dev",
    "start": "node host/server/main.ts",
    "build:version": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=120000 --test-reporter=spec \"test/**/*.test.ts\" \"host/**/*.test.ts\" \"modules/**/*.test.ts\"",
    "coverage": "c8 node --test --test-timeout=120000 \"test/**/*.test.ts\" \"host/**/*.test.ts\" \"modules/**/*.test.ts\"",
    "docs": "node scripts/docs-index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "express": "^5.2.1",
    "material-icon-theme": "^5.38.1",
    "pyright": "^1.1.414",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
