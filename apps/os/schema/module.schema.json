{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NexoDigital-Lab/Agent-Os-Nexo/apps/os/schema/module.schema.json",
  "title": "agent-os module manifest (module.json)",
  "type": "object",
  "required": ["name", "version", "description"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Must match the module folder name." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "owner": { "enum": ["nexo", "user"], "default": "user" },
    "dependsOn": { "type": "array", "items": { "type": "string" }, "default": [] },
    "core": { "type": "boolean", "default": false, "description": "Core modules cannot be disabled." },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "string", "description": "Path to the server entry, relative to the module." },
        "web": { "type": "string", "description": "Path to the web entry, relative to the module." }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "integer" }
      }
    }
  }
}
