{
  "$comment": "Preset: strict. allow = do it, ask = ask first, deny = never. Unlisted actions use default.",
  "default": "ask",
  "files": {
    "read": {
      "allow": [
        "**"
      ],
      "deny": [
        "library/connections/**/*.secret*",
        "projects/**/secrets/**",
        "os/data/vault/**",
        ".state/**"
      ]
    },
    "edit": {
      "allow": [
        "library/memory/**"
      ],
      "ask": [
        "projects/**/code/**",
        "library/skills/**",
        "library/agents/**",
        "library/hooks/**",
        "library/commands/**",
        "blueprints/**",
        "os/source/**",
        "projects/*/context/**",
        "projects/*/*/context/**"
      ],
      "deny": [
        "os/data/**",
        "library/permissions.json",
        "projects/**/context/permissions.json",
        ".state/**"
      ]
    }
  },
  "commands": {
    "allow": [
      "git status*",
      "git diff*",
      "git log*",
      "nexo doctor*",
      "nexo os versions*"
    ],
    "ask": [
      "git add*",
      "git commit*",
      "npm test*",
      "npm run *",
      "git push*",
      "git checkout*",
      "git reset*",
      "git rebase*",
      "npm install*",
      "docker *",
      "nexo analyze*",
      "nexo update*",
      "nexo clone*",
      "nexo new*",
      "nexo connect*"
    ],
    "deny": [
      "git push --force*",
      "git push -f*",
      "rm -rf *",
      "sudo *"
    ]
  },
  "connections": {
    "*": {
      "read": "ask",
      "write": "ask",
      "delete": "deny"
    }
  },
  "os": {
    "build": "ask",
    "restart": "deny",
    "vault": "deny"
  }
}
